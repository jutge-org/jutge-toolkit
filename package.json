{
    "name": "@jutge.org/toolkit",
    "description": "Toolkit to prepare problems for Jutge.org",
    "version": "4.4.55",
    "homepage": "https://jutge.org",
    "author": {
        "name": "Jutge.org",
        "url": "https://jutge.org"
    },
    "contributors": [
        {
            "name": "Jordi Petit",
            "url": "https://github.com/jordi-petit"
        },
        {
            "name": "Pau Fernández",
            "url": "https://github.com/pauek"
        },
        {
            "name": "Cristina Raluca",
            "url": "https://github.com/ralucado"
        },
        {
            "name": "Jordi Reig",
            "url": "https://github.com/jordireig"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jutge-org/jutge-toolkit.git"
    },
    "keywords": [
        "jutge.org",
        "cli",
        "command line interface"
    ],
    "publishConfig": {
        "access": "public"
    },
    "module": "index.ts",
    "type": "module",
    "bin": {
        "jutge-toolkit": "dist/index.js",
        "jtk": "dist/index.js",
        "jtk-dev": "toolkit/index.ts"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "bun prettier --write .",
        "depcheck": "bunx depcheck",
        "dev": "bun build --target bun --outfile dist/index.js ./toolkit --watch",
        "build": "bun build --target bun --minify --outfile dist/index.js ./toolkit",
        "update-jutge-client": "(cd lib ; rm -f jutge_api_client.ts ; jutge clients typescript)"
    },
    "files": [
        "README.md",
        "dist",
        "toolkit",
        "docs",
        "assets"
    ],
    "dependencies": {
        "@commander-js/extra-typings": "^15.0.0",
        "@dicebear/collection": "^9.4.2",
        "@dicebear/core": "^9.4.3",
        "@eslint/js": "^10.0.1",
        "@inquirer/prompts": "^8.7.5",
        "adm-zip": "^0.6.1",
        "archiver": "^8.0.0",
        "boxen": "^9.0.0",
        "bun-types": "^1.4.4",
        "chalk": "^6.0.1",
        "chokidar": "^6.0.0",
        "cli-highlight": "^2.1.11",
        "cli-table3": "^0.6.5",
        "commander": "^15.0.0",
        "dayjs": "^1.11.23",
        "env-paths": "^4.0.0",
        "eslint": "^10.14.0",
        "execa": "^10.2.1",
        "handlebars": "^4.7.10",
        "image-size": "^2.0.4",
        "inquirer-checkbox-plus-plus": "^1.2.0",
        "marked": "^18.1.3",
        "marked-terminal": "^8.0.0",
        "nanoid": "^6.0.2",
        "open": "^11.0.4",
        "pretty-bytes": "^7.2.0",
        "pretty-ms": "^10.0.0",
        "radash": "^12.1.1",
        "semver": "^7.8.6",
        "sharp": "^0.35.5",
        "terminal-link": "^5.0.0",
        "tree-node-cli": "^3.0.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7",
        "zod-package-json": "^2.1.0",
        "zod-validation-error": "^5.0.0"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.6.0",
        "@types/archiver": "^8.0.0",
        "@types/image-size": "^0.8.0",
        "@types/marked-terminal": "^6.1.1",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.8.0",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.72.1"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "trailingComma": "all",
        "tabWidth": 4,
        "useTabs": false,
        "arrowParens": "always",
        "printWidth": 120
    }
}
